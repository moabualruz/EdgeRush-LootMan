# =============================================================================
# EdgeRush LootMan Environment Configuration
# =============================================================================
# Copy this file to .env or .env.local and fill in your values.
# Never commit .env to git!
#
# For production, use SOPS + age for secrets management:
#   ./scripts/setup-secrets.sh
#   sops secrets/secrets.enc.yaml

# SOPS secrets path (set to use encrypted secrets)
# SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edgerush
POSTGRES_USER=edgerush
POSTGRES_PASSWORD=edgerush
SQLITE_FILE=build/edgerush.db

# =============================================================================
# WoWAudit Integration
# =============================================================================
WOWAUDIT_API_KEY=
WOWAUDIT_GUILD_URI=https://wowaudit.com/REGION/REALM/GUILD/profile

# =============================================================================
# Warcraft Logs Integration
# =============================================================================
WARCRAFT_LOGS_CLIENT_ID=
WARCRAFT_LOGS_CLIENT_SECRET=

# =============================================================================
# Discord OAuth2
# =============================================================================
# Setup:
#   1. Go to https://discord.com/developers/applications
#   2. Click "New Application" -> Name it (e.g., "LootMan Dev")
#   3. Go to OAuth2 -> Copy Client ID and Client Secret
#   4. Go to OAuth2 -> Redirects -> Add redirect URI below
#
# Redirect URIs to add in Discord Developer Portal:
#   Development: http://localhost/auth/discord/callback
#   Production:  https://yourdomain.com/auth/discord/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost/auth/discord/callback

# =============================================================================
# Battle.net OAuth2
# =============================================================================
# Setup:
#   1. Go to https://develop.battle.net/
#   2. Login / Create account -> Go to API Access
#   3. Click "Create Client"
#   4. Copy Client ID and Client Secret
#   5. Add redirect URIs
#
# Redirect URIs to add in Battle.net Developer Portal:
#   Development: http://localhost/auth/battlenet/callback
#   Production:  https://yourdomain.com/auth/battlenet/callback

BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_REDIRECT_URI=http://localhost/auth/battlenet/callback
BATTLENET_REGION=us

# =============================================================================
# JWT / Session Security
# =============================================================================
# Generate a secure secret with: openssl rand -base64 64
# MUST be at least 256 bits (32 bytes) for HS256
# Leave empty for development (auto-generates, but tokens won't persist across restarts)

JWT_SECRET=

# =============================================================================
# Simulation Configuration (local SimulationCraft via Docker)
# =============================================================================
SIMULATION_DOCKER_IMAGE=simulationcraftorg/simc
SIMULATION_DOCKER_PROFILE_DIR=./simc-profiles
SIMULATION_DOCKER_TIMEOUT_MINUTES=30

# =============================================================================
# Web Dashboard Configuration (build-time args for Vite)
# =============================================================================
VITE_API_URL=/api
VITE_WS_URL=
# These should match the OAuth client IDs above (frontend needs them for OAuth flow)
VITE_DISCORD_CLIENT_ID=
VITE_BATTLENET_CLIENT_ID=
